# 後端專用。請勿加入 VITE_ 前綴或輸入前端。
# 設定 NVIDIA_API_KEY 後會使用 NVIDIA。NVIDIA_MODEL 留空會使用預設模型。
NVIDIA_API_KEY=
NVIDIA_MODEL=
# 沒有 NVIDIA 金鑰時，可用下列兩項設定 OpenAI。
OPENAI_API_KEY=
# 指定目前帳戶可用且支援 Structured Outputs 的模型
OPENAI_MODEL=
PORT=3000

# Vercel 會員版。Preview 與 Production 連各自的服務。
MANDALA_ORIGIN=
# 選填。只在 Preview 加入另一個已綁定的 HTTPS 網址。
MANDALA_PREVIEW_ORIGIN=
# 只在 Vercel Production 生效。設為 1 時僅提供公開訪客試用。
MANDALA_PUBLIC_TRIAL_ONLY=
MANDALA_TRIAL_SECRET=
CRON_SECRET=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Clerk Marketplace 提供 NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY 時可以沿用。
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# 在 Vercel 連接 Private Blob 後可由平台提供 BLOB_STORE_ID 與 OIDC。
BLOB_READ_WRITE_TOKEN=
# Polar 的 Sandbox 與正式商品及憑證彼此獨立。
POLAR_SERVER=sandbox
POLAR_PRODUCT_ID=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
